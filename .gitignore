# Xcode user-specific state — never committed; differs per machine.
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Build outputs.
DerivedData/
build/
*.ipa
*.dSYM
*.dSYM.zip

# CocoaPods / Swift Package Manager — not used today but futureproof.
Pods/
.build/
.swiftpm/
Package.resolved

# OS cruft.
.DS_Store

# The Xcode project file is regenerated by xcodegen; track project.yml
# instead. Commenting out for now since we want at least the initial
# checkout to ship a working .xcodeproj — re-enable after the first
# few teammates have run xcodegen locally.
# *.xcodeproj/

# Local-only config that shouldn't ship publicly (signing identities,
# personal API keys baked into preview-data, etc.)
*.local.swift
